datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  userId       Int           @id
  username     String        @unique @db.VarChar(255)
  books        Book[]
  readingStatuses ReadingStatus[]
  reviews      Review[]

  @@map(name: "users")
}

model Book {
  bookId          String          @id @db.Uuid
  title           String          @db.VarChar(255)
  author          String          @db.VarChar(255)
  description     String          @db.Text
  createdBy       Int
  updatedAt       DateTime        @db.Timestamptz(6)
  user            User            @relation(fields: [createdBy], references: [userId], onDelete: Cascade)
  readingStatuses ReadingStatus[]
  reviews         Review[]

  @@index(fields: [createdBy])
  @@map(name: "books")
}

model ReadingStatus {
  readingStatusCompositeId String @id @db.VarChar(255)
  bookId                   String @db.Uuid
  userId                   Int
  status                   Int    // 0: 気になる/積読, 1: 読書中, 2: 読了
  book                     Book   @relation(fields: [bookId], references: [bookId], onDelete: Cascade)
  user                     User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([bookId, userId])
  @@map(name: "reading_statuses")
}

model Review {
  reviewCompositeId String   @id @db.VarChar(255)
  bookId            String   @db.Uuid
  userId            Int
  reviewText        String   @db.Text
  updatedAt         DateTime @db.Timestamptz(6)
  book              Book     @relation(fields: [bookId], references: [bookId], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([bookId, userId])
  @@map(name: "reviews")
}